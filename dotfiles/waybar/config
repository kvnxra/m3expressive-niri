{
    "layer": "top",
    "position": "top",
    "height": 44,
    "margin": "8px 12px 0 12px",
    "spacing": 8,
    "modules-left": ["niri/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["niri/language", "idle_inhibitor", "mpris", "network", "pulseaudio", "custom/dnd", "tray"],

    "niri/workspaces": {
        "format": "{index}",
        "disable-scroll": true,
        "all-outputs": false
    },

    "clock": {
        "interval": 30,
        "format": "{:%H:%M}",
        "format-alt": "{:%a, %d %b}",
        "tooltip-format": "<big>{:%Y-%m-%d}</big>\n<tt>{calendar}</tt>"
    },

    "niri/language": {
        "format": "{short}",
        "on-click": "niri msg action switch-layout next",
        "tooltip": false
    },

    "idle_inhibitor": {
        "format": "<span font_family='Material Symbols Rounded' size='large'>{icon}</span>",
        "format-icons": {
            "activated": "visibility",
            "deactivated": "visibility_off"
        },
        "tooltip-format-activated": "Экран не гаснет",
        "tooltip-format-deactivated": "Обычный режим"
    },

    "mpris": {
        "format": "{status_icon}  {dynamic}",
        "format-paused": "{status_icon}  {dynamic}",
        "format-stopped": "",
        "status-icons": {
            "playing": "\ue034",
            "paused": "\ue037"
        },
        "max-length": 34,
        "tooltip": true,
        "tooltip-format": "{player}\n{dynamic}",
        "on-click": "@HOME@/.local/bin/md3-player",
        "on-click-middle": "playerctl play-pause",
        "on-click-right": "playerctl next"
    },

    "network": {
        "format-wifi": "<span font_family='Material Symbols Rounded' size='large'>wifi</span>",
        "format-ethernet": "<span font_family='Material Symbols Rounded' size='large'>lan</span>",
        "format-disconnected": "<span font_family='Material Symbols Rounded' size='large'>wifi_off</span>",
        "tooltip-format": "{ifname}: {essid}\n{ipaddr}",
        "on-click": "nm-connection-editor",
        "interval": 10
    },

    "pulseaudio": {
        "format": "<span font_family='Material Symbols Rounded' size='large'>{icon}</span>  {volume}%",
        "format-muted": "<span font_family='Material Symbols Rounded' size='large'>volume_off</span>  {volume}%",
        "format-icons": {
            "default": ["volume_mute", "volume_down", "volume_up"]
        },
        "max-volume": 100,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- --limit 1.0"
    },

    "custom/dnd": {
        "exec": "@HOME@/.config/waybar/scripts/dnd.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 11,
        "format": "<span font_family='Material Symbols Rounded' size='large'>{icon}</span>",
        "format-icons": {
            "on": "notifications_off",
            "off": "notifications"
        },
        "tooltip": true,
        "on-click": "@HOME@/.config/waybar/scripts/dnd-toggle.sh"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    }
}
