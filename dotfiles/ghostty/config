# Ghostty · цвета берутся из themes/current (генерирует md3)
theme = current
font-family = JetBrainsMono Nerd Font
font-size = 12

window-decoration = false
window-padding-x = 14
window-padding-y = 12
background-opacity = 1.0
gtk-titlebar = false
gtk-single-instance = true

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false
scrollback-limit = 20000000
app-notifications = no-clipboard-copy,no-config-reload
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor

# Ctrl+C копирует, только если есть выделение; иначе — обычное прерывание. Работает и в русской раскладке
keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+с=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+м=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
